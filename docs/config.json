{
  "name": "Movies TV Live",
  "description": "Movies and shows from Stremio-protocol addons, plus live TV channels from channel lists you add. Shows and live channels are channels, seasons are playlists.",
  "author": "Black-B0x",
  "authorUrl": "https://github.com/Black-B0x",
  "repositoryUrl": "https://github.com/Black-B0x/movies_tv_live_grayjay_addon",
  "scriptUrl": "./script.js",
  "iconUrl": "./icon.png",
  "id": "197e322b-ec7f-42f3-a302-dabbcaf75749",
  "version": 3,
  "scriptSignature": "",
  "scriptPublicKey": "",
  "packages": [
    "Http"
  ],
  "allowEval": false,
  "allowUrls": [
    "everywhere"
  ],
  "settings": [
    {
      "variable": "homeHeader",
      "name": "Home",
      "description": "",
      "type": "Header"
    },
    {
      "variable": "homeContent",
      "name": "Home feed shows",
      "description": "What the Home tab shows. Everything = live TV channels (if you pasted a channel list) followed by movies and shows from your addons' catalogs.",
      "type": "Dropdown",
      "default": "0",
      "options": [
        "Everything",
        "Movies only",
        "Shows only",
        "Live TV only"
      ]
    },
    {
      "variable": "addonsHeader",
      "name": "Addons",
      "description": "",
      "type": "Header"
    },
    {
      "variable": "addon0",
      "name": "Cinemeta",
      "description": "https://v3-cinemeta.strem.io/manifest.json",
      "type": "Boolean",
      "default": "true"
    },
    {
      "variable": "addon1",
      "name": "OpenSubtitles",
      "description": "https://opensubtitles-v3.strem.io/manifest.json",
      "type": "Boolean",
      "default": "true"
    },
    {
      "variable": "streamsHeader",
      "name": "Streams",
      "description": "",
      "type": "Header"
    },
    {
      "variable": "maxResolution",
      "name": "Maximum resolution",
      "description": "Hide streams above this resolution (if that leaves nothing, all are shown).",
      "type": "Dropdown",
      "default": "0",
      "options": [
        "No limit",
        "2160p (4K)",
        "1080p",
        "720p",
        "480p"
      ]
    },
    {
      "variable": "streamOrder",
      "name": "Stream order",
      "description": "How the quality list is sorted.",
      "type": "Dropdown",
      "default": "0",
      "options": [
        "Highest quality first",
        "Addon order"
      ]
    },
    {
      "variable": "showsHeader",
      "name": "Shows",
      "description": "",
      "type": "Header"
    },
    {
      "variable": "hideUnreleased",
      "name": "Hide unaired episodes",
      "description": "Leave out episodes with a future air date.",
      "type": "Boolean",
      "default": "true"
    },
    {
      "variable": "includeSpecials",
      "name": "Specials in latest episodes",
      "description": "Include season 0 in a show's Videos tab and your Subscriptions feed.",
      "type": "Boolean",
      "default": "false"
    },
    {
      "variable": "subsHeader",
      "name": "Subtitles",
      "description": "",
      "type": "Header"
    },
    {
      "variable": "subtitlesEnabled",
      "name": "Load subtitles",
      "description": "Ask subtitle addons (e.g. OpenSubtitles) for subtitles.",
      "type": "Boolean",
      "default": "true"
    },
    {
      "variable": "subtitleLanguage",
      "name": "Subtitle language",
      "description": "",
      "type": "Dropdown",
      "default": "1",
      "options": [
        "All languages",
        "English",
        "Spanish",
        "Portuguese",
        "French",
        "German",
        "Italian",
        "Dutch",
        "Polish",
        "Russian",
        "Turkish",
        "Arabic",
        "Hindi",
        "Japanese",
        "Korean",
        "Chinese"
      ]
    }
  ]
}